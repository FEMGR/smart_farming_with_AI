  "nitidulid_beetle": {
    "pest_id": "nitidulid_beetle",
    "display_name": "Nitidulid beetle",
    "pest_type": "insect",
    "plants_affected": [
      "bean",
      "snap",
      "pumpkin",
      "squash"
    ],
    "plant_groups_affected": [],
    "damage": [
      "Pest description and crop damage Nitidulid beetles are rarely a pest of snap beans and rarely require treatment. Adult beetles are small and black. They infest blossoms from mid-July to mid-August. They may cause blossom drop, but control is unnecessary unless populations are very high."
    ],
    "symptoms": [],
    "favorable_conditions": [
      "Pest description and crop damage Nitidulid beetles are rarely a pest of snap beans and rarely require treatment. Adult beetles are small and black. They infest blossoms from mid-July to mid-August. They may cause blossom drop, but control is unnecessary unless populations are very high."
    ],
    "prevention": [],
    "treatment": [
      "Pest description and crop damage Nitidulid beetles are rarely a pest of snap beans and rarely require treatment. Adult beetles are small and black. They infest blossoms from mid-July to mid-August. They may cause blossom drop, but control is unnecessary unless populations are very high.",
      "Management-chemical control: HOME USE",
      "No products are registered for control of this pest.",
      "Management-chemical control: COMMERCIAL USE",
      "Most insecticides labeled for use on green beans for aphids or other pest of.beans reduce nitidulid beetle populations."
    ],

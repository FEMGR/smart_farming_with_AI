  "garden_symphylan": {
    "pest_id": "garden_symphylan",
    "display_name": "Garden symphylan",
    "pest_type": null,
    "plants_affected": [
      "asparagus",
      "bean",
      "snap",
      "beet",
      "table",
      "broccoli",
      "brussels_sprout",

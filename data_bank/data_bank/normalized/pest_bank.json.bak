  "cutworm": {
    "pest_id": "cutworm",
    "display_name": "Cutworm",
    "pest_type": "insect",
    "plants_affected": [
      "artichoke",
      "broccoli",
      "brussels_sprout",
      "cabbage",
      "cauliflower",
      "corn",

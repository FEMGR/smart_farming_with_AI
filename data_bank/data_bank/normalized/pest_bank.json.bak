  "armyworm": {
    "pest_id": "armyworm",
    "display_name": "Armyworm",
    "pest_type": "insect",
    "plants_affected": [
      "broccoli",
      "brussels_sprout",
      "cabbage",
      "cauliflower",
      "corn",

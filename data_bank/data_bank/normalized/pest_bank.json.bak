  "thrips": {
    "pest_id": "thrips",
    "display_name": "Thrips",
    "pest_type": "insect",
    "plants_affected": [
      "bean",
      "dry",
      "broccoli",
      "brussels_sprout",
      "cabbage",
      "cauliflower",
      "corn",

  "looper": {
    "pest_id": "looper",
    "display_name": "Looper",
    "pest_type": "insect",
    "plants_affected": [
      "broccoli",
      "brussels_sprout",
      "cabbage",
      "cauliflower",
      "cucumber",
      "endive",
